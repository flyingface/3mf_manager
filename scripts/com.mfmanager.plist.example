<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  3MF Manager macOS 开机自启（launchd）示例

  安装（详见 MACOS.md「开机自启」一节）:
    1. 把下面 5 处 /Users/USER/path/to/3mf_manager 替换为你的实际项目路径，
       一条 sed 搞定（假设项目在 ~/workspace/3mf_manager）:
       sed -e "s|/Users/USER/path/to/3mf_manager|$HOME/workspace/3mf_manager|g" \
           scripts/com.mfmanager.plist.example > ~/Library/LaunchAgents/com.mfmanager.plist
    2. launchctl load ~/Library/LaunchAgents/com.mfmanager.plist

  卸载/停止:
    launchctl unload ~/Library/LaunchAgents/com.mfmanager.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mfmanager</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/USER/path/to/3mf_manager/.venv/bin/python</string>
        <string>/Users/USER/path/to/3mf_manager/server.py</string>
        <string>8000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/USER/path/to/3mf_manager</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/USER/path/to/3mf_manager/logs/launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/USER/path/to/3mf_manager/logs/launchd.err</string>
</dict>
</plist>
